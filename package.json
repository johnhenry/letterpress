{
  "name": "@johnhenry/letterpress",
  "version": "0.0.3",
  "description": "A tagged-template-string HTTP routing library for defining and matching request handlers with plain JavaScript syntax.",
  "main": "index.mjs",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.mjs"
    },
    "./fs": {
      "types": "./fs.d.ts",
      "default": "./fs-router.mjs"
    },
    "./rewrite": {
      "types": "./rewrite.d.ts",
      "default": "./rewrite.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/letterpress.git"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:server": "node demo/server.mjs",
    "demo:client": "node demo/client.mjs"
  },
  "keywords": [
    "router",
    "routing",
    "http",
    "tagged-template",
    "template-literal",
    "request",
    "response"
  ],
  "author": "John Henry",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johnhenry/letterpress/issues"
  },
  "homepage": "https://opensource.johnhenry.me/letterpress/",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@johnhenry/leserve": "^0.0.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "theres-waldo": "^0.0.0"
  }
}